#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:108
msgid "Setting up the LCD"
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:115
msgid "This segment of code includes the LiquidCrystal_I2C library and initializes the LCD module with the I2C address as ``0x27`` and specifies that the LCD has ``16`` columns and ``2`` rows."
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:117
msgid "Setting up Bluetooth communication"
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:126
msgid "Here, the SoftwareSerial library is included to allow the JDY-31 Bluetooth module to communicate with the Arduino using pins 3 (TX) and 4 (RX)."
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:128
msgid "Initialization"
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:141
msgid "The ``setup()`` function initializes the LCD and clears any existing content. It also turns on the backlight for the LCD. Communication is started with the serial monitor and the Bluetooth module, both at a baud rate of ``9600``."
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:143
msgid "Main Loop"
msgstr ""

#: ../../source/iot_project_esp01/15-iot_Bluetooth_lcd.rst:165
msgid "This is the main operational loop of the Arduino program. It continually checks for incoming data from both the Bluetooth module and the serial monitor. When data is received from the Bluetooth device, it's processed, displayed on the serial monitor, and shown on the LCD. If data is entered into the serial monitor, this data is sent to the Bluetooth module."
msgstr ""
