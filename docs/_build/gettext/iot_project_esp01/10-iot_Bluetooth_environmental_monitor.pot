msgid "This segment initializes serial communication for debugging, Bluetooth module, and the DHT sensor."
msgstr ""

#: ../../source/iot_project_esp01/10-iot_Bluetooth_environmental_monitor.rst:228
msgid "Reading data and sending via Bluetooth."
msgstr ""

#: ../../source/iot_project_esp01/10-iot_Bluetooth_environmental_monitor.rst:259
msgid "This segment reads temperature and humidity from the DHT11 sensor every 2 seconds. If the reading fails, it prints an error message. Otherwise, it prints the readings to the Serial Monitor and sends them via the Bluetooth module in a comma-separated format. When the app receives data in the format of \"temperature,humidity\", it will parse the information and present it on the user interface."
msgstr ""
