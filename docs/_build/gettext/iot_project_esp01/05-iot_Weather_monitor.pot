#: ../../source/iot_project_esp01/05-iot_Weather_monitor.rst:19
msgid "Weather Monitor with ThingSpeak"
msgstr ""

#: ../../source/iot_project_esp01/05-iot_Weather_monitor.rst:28
msgid "This project collects temperature and pressure data using an Atmospheric Pressure Sensor. The collected data is then transmitted to the ThingSpeak cloud platform via an ESP8266 module and Wi-Fi network at regular time intervals."
msgstr ""

