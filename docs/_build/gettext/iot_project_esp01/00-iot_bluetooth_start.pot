#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:99
msgid "4. Communicating through Bluetooth debugging tools on mobile phones"
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:101
msgid "We can use an app called \"Serial Bluetooth Terminal\" to send messages from the Bluetooth module to Arduino, simulating the process of Bluetooth interaction. The Bluetooth module will send received messages to Arduino through serial port, and similarly, Arduino can also send messages to bluetooth module through serial port."
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:103
msgid "**Install Serial Bluetooth Terminal**"
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:105
msgid "Go to Google Play to download and install |link_serial_bluetooth_terminal| ."
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:108
msgid "**Connect Bluetooth**"
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:110
msgid "Initially, turn on **Bluetooth** on your smartphone."
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:116
msgid "Navigate to the **Bluetooth settings** on your smartphone and look for names like **JDY-31-SPP**."
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:122
msgid "After clicking it, agree to the **Pair** request in the pop-up window. If prompted for a pairing code, please enter \"1234\"."
msgstr ""

