msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:135
msgid "After successful connection, you can see the prompt of successful connection in the serial port monitor."
msgstr ""

#: ../../source/iot_project_esp01/00-iot_bluetooth_start.rst:139
