msgid "1.2 Adding the required libraries"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:20
msgid "You need to add the correct libraries for the Arduino IDE to use Blynk."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:22
msgid "Click |link_blynk_lib|, scroll down to **\"Assets\"** and download the first ``.zip`` file."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:25
msgid "Please note that the version number shown in the image below may be outdated. We highly recommend downloading and installing the latest version available."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:29
msgid "Unzip this file and then enter the ``libraries`` folder to see the following folders."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:33
msgid "Copy them all and add them to the ``libraries`` folder of your sketchbook."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:35
msgid "**Step 1:** You can find or change the location of your libraries folder at ``File > Preferences > Sketchbook location``."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:39
msgid "**Step 2:** Go to the location of your Sketchbook location(find from Arduino IDE). And find ``libraries`` folder, click to open it."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:43
msgid "**Step 3:** Paste all the unzipped folders of ``Blynk_Release_vx.x.x\\libraries`` into the libraries folder."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:49
msgid "The release zips of **Blynk 1.4.0 and later** only contain the `Blynk` folder. The Wi-Fi projects in this kit also need `ESP8266_Lib.h`, which ships in a **separate** library called **BlynkESP8266** and is not available in Library Manager. Install it as follows:"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:54
msgid "Open https://github.com/vshymanskyy/BlynkESP8266"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:55
msgid "Click **Code -> Download ZIP**"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:56
msgid "In the Arduino IDE choose **Sketch -> Include Library -> Add .ZIP Library**"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/03-iot_add_lib.rst:57
msgid "Restart the Arduino IDE"
msgstr ""

