#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:18
msgid "1.3 Connecting the R4 board to Blynk"
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:20
msgid "Reconnect the ESP8266 module and R4 board, here the software serial is used, so TX and RX are connected to pins 2 and 3 of R4 board respectively."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:24
msgid "The ESP8266 module requires a high current to provide a stable operating environment, so make sure the 9V battery is plugged in."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:29
msgid "Click the **devices** page and you will see the new device you just created. Then, click developer tools."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:33
msgid "And you will see ``TEMPLATE_ID``, ``DEVICE_NAME`` and ``AUTH_TOKEN`` on the **Firmware info**, and you will need to copy them later."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:39
msgid "Open the ``00-Blynk_quick_start.ino`` file under the path of ``ultimate-sensor-kit\\code\\iot_project_esp01\\wifi\\00-Blynk_quick_start``. Or copy this code into **Arduino IDE**."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:45
msgid "Replace the following three lines of code that you can copy from your account's **Firmware info** page. These three lines of code will allow your R4 board to find your blynk account."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:55
msgid "Fill in the ``ssid`` and ``password`` of the WiFi you are using."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:62
msgid "Upload the code to the R4 board, then open the serial monitor and set the baud rate to 115200. when the R4 board communicates with Blynk successfully, the serial monitor will show the ``ready`` character."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:68
msgid "If the message ``ESP is not responding`` appears when you connect, please follow these steps."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:70
msgid "Make sure the 9V battery is plugged in."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:71
msgid "Reset the ESP8266 module by connecting the pin RST to GND for 1 second, then unplug it."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:72
msgid "Press the reset button on the R4 board."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:74
msgid "Sometimes, you may need to repeat the above operation 3-5 times, please be patient."
msgstr ""

#: ../../source/iot_project_esp01/blynk_start/04-iot_connect_r4_blynk.rst:76
msgid "The status of Blynk will change from **offline** to **online**."
msgstr ""
