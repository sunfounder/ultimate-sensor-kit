#: ../../source/arduino_start/01_install_arduino_ide.rst:18
msgid "Download and Install Arduino IDE 2.0"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:20
msgid "The Arduino IDE, known as Arduino Integrated Development Environment, provides all the software support needed to complete an Arduino project. It is a programming software specifically designed for Arduino, provided by the Arduino team, that allows us to write programs and upload them to the Arduino board."
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:22
msgid "The Arduino IDE 2.0 is an open-source project. It is a big step from its sturdy predecessor, Arduino IDE 1.x, and comes with revamped UI, improved board & library manager, debugger, autocomplete feature and much more."
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:24
msgid "In this tutorial, we will show how to download and install the Arduino IDE 2.0 on your Windows, Mac, or Linux computer."
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:27
msgid "Requirements"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:29
msgid "Windows - Win 10 and newer, 64 bits"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:30
msgid "Linux - 64 bits"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:31
msgid "Mac OS X - Version 10.14: \"Mojave\" or newer, 64 bits"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:34
msgid "Download the Arduino IDE 2.0"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:36
msgid "Visit |link_download_arduino|."
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:38
