msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:43
msgid "Installation"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:46
msgid "Windows"
msgstr ""

#: ../../source/arduino_start/01_install_arduino_ide.rst:48
