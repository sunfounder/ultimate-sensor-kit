#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:18
msgid "1.2 Install Libraries"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:20
msgid "The sketches need **two** libraries. One comes from the Arduino Library Manager, the other one has to be downloaded and added by hand."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:23
msgid "**Install the Blynk library**"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:25
msgid "In the Arduino IDE open **Library Manager**, search for ``blynk`` and click **INSTALL**."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:31
msgid "The installer also asks for **BlynkNcpDriver** - choose **INSTALL ALL**."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:38
msgid "The library is called **BlynkESP8266** and defines ``ESP8266 wifi;`` - those names are historical, they come from the module Blynk was written for years ago. They work exactly the same with the ESPC2-01, which also answers the AT commands."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:42
msgid "**Install the BlynkESP8266 library**"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:44
msgid "This one is not in the Library Manager, so it has to be downloaded from GitHub."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:46
msgid "Download `BlynkESP8266 <https://github.com/vshymanskyy/BlynkESP8266/archive/refs/heads/master.zip>`_."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:48
msgid "In the Arduino IDE choose **Sketch -> Include Library -> Add .ZIP Library...**"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:53
msgid "Select the downloaded zip file - there is no need to unzip it first."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:58
msgid "Restart the Arduino IDE after the library has been added."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-install_libs.rst:62
msgid "This library uses the old 1.0 layout, so the IDE may report that it cannot read a version number. The warning can be ignored - the sketches compile and upload without problems."
msgstr ""
