#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:18
msgid "1.3 Connecting the R4 board to Blynk"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:20
msgid "Connect the ESPC2-01 module to the Arduino Uno R4 Minima."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:24
msgid "The module draws a high current at start-up, so make sure the 9V battery or an external power supply is plugged into the DC jack of the R4 Minima."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:29
msgid "Open the ``00-Blynk_quick_start.ino`` file under the path of ``ultimate-sensor-kit\\code\\iot_project_espc201\\wifi\\00-Blynk_quick_start``."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:32
msgid "Replace the following three lines with the ones you copied from your account's **Device** page. They tell the board which Blynk account it belongs to."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:44
msgid "Fill in the ``ssid`` and ``password`` of the Wi-Fi network you are using."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:51
msgid "Upload the code, open the Serial Monitor and set the baud rate to **115200**. When the board has reached the Blynk cloud the monitor shows ``Ready``."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:59
msgid "If ``ESP is not responding`` appears, check the following:"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:61
msgid "The external power supply is connected;"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:62
msgid "The module sits firmly in the adapter and IO9 is left floating;"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:63
msgid "Press the reset button on the R4 board."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:65
msgid "It may take two or three tries."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/00-connect_r4_blynk.rst:67
msgid "The device status in the Blynk.Console changes from **offline** to **online**."
msgstr ""

