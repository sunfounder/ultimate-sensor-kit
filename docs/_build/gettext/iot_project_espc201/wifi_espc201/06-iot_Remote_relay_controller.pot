msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:78
msgid "Click **Datastreams**, then **Create New**."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:83
