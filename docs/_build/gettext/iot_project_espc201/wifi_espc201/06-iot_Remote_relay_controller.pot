msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:94
msgid "**Add the web dashboard**"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:96
msgid "Click **Dashboard**, then **Add Widget**."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:101
msgid "Drag a **Switch** widget onto the dashboard."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:106
msgid "Click the three dots in the corner of the **Switch** and choose **Settings**."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:108
msgid "Set **Datastream** to ``Relay Status (V7)``."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:112
msgid "A **Switch** both shows and sets the value. Tapping it sends ``1`` or ``0`` to the board; the board switches the relay and writes the same value back, so the switch never gets out of step - even if you tap it twice quickly."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:120
msgid "Click **Save**."
msgstr ""

