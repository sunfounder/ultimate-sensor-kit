msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:88
msgid "**DATA TYPE**: **Integer**"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/06-iot_Remote_relay_controller.rst:89
