#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:18
msgid "4. Vibration Alert System with IFTTT"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:27
msgid "A vibration switch (SW-420) sits on the desk. When the desk is knocked, the board tells IFTTT what happened, and IFTTT sends you an email."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:30
msgid "This project does **not** use Blynk. It sends a plain HTTP request straight to IFTTT, so you can see what the module really does with an AT command such as ``AT+CIPSEND`` - the same thing your browser does when you open a web page."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:34
msgid "To keep your inbox calm, two alerts are always at least **two minutes** apart."
msgstr ""

