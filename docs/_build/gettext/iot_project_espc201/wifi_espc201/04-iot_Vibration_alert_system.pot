msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:57
msgid "|link_ifttt| is a free service that connects apps together with a simple rule:"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:59
