msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:61
msgid "Here we need two parts:"
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:63
msgid "**If This** - someone shakes the sensor. IFTTT gives us a private web address that we can call from the board."
msgstr ""

#: ../../source/iot_project_espc201/wifi_espc201/04-iot_Vibration_alert_system.rst:65
msgid "**Then That** - send an email. That is the action."
msgstr ""

