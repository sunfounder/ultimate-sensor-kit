msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/13-iot_Bluetooth_piano.rst:78
msgid "Set the format in the top right corner to **UTF-8 String** and type ``NOTE_C4*``. The picture shows the field just before sending:"
msgstr ""

