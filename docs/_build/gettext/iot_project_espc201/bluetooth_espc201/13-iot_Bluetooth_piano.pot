#: ../../source/iot_project_espc201/bluetooth_espc201/13-iot_Bluetooth_piano.rst:69
msgid "3. Play a Note from the Phone"
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/13-iot_Bluetooth_piano.rst:71
msgid "Open LightBlue, tap **Scan** and connect to **SunFounder-C2**."
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/13-iot_Bluetooth_piano.rst:73
