#: ../../source/iot_project_espc201/bluetooth_espc201/08-iot_Bluetooth_lcd.rst:17
msgid "8. Bluetooth LCD"
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/08-iot_Bluetooth_lcd.rst:26
msgid "Type a word on the phone and it appears on the LCD - no cable, no Wi-Fi, no internet."
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/08-iot_Bluetooth_lcd.rst:28
msgid "The board is the same **SunFounder-C2** module from the previous chapter, used the same way: the phone writes text to characteristic **C304** and the sketch reads it."
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/08-iot_Bluetooth_lcd.rst:33
msgid "1. Build the Circuit"
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/08-iot_Bluetooth_lcd.rst:37
msgid "The module draws a high current at start-up, so make sure the 9 V battery or an external power supply is plugged into the DC jack of the R4 Minima."
msgstr ""

