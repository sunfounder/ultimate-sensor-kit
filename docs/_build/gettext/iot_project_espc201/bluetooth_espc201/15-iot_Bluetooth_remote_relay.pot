msgid "15. Bluetooth Remote Relay"
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/15-iot_Bluetooth_remote_relay.rst:26
msgid "A relay is a switch that is moved by an electromagnet, so a small signal can control a much bigger load. Send ``1`` and the relay closes, send ``0`` and it opens."
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/15-iot_Bluetooth_remote_relay.rst:31
msgid "1. Build the Circuit"
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/15-iot_Bluetooth_remote_relay.rst:35
msgid "The relay in this kit switches small DC loads only. **Never connect mains voltage** while learning - 220 V can kill you and there is no need for it here."
msgstr ""

#: ../../source/iot_project_espc201/bluetooth_espc201/15-iot_Bluetooth_remote_relay.rst:39
msgid "The module draws a high current at start-up, so make sure the 9 V battery or an external power supply is plugged into the DC jack of the R4 Minima."
msgstr ""

