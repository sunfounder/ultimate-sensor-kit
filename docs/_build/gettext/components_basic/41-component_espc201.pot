#: ../../source/components_basic/41-component_espc201.rst:60
msgid "Features and specifications"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:62
msgid "Chip: **ESP32-C2** (ESP8684H2), single core 32-bit RISC-V"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:63
msgid "Wi-Fi: 802.11 b/g/n (Wi-Fi 4), **2.4 GHz only**"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:64
msgid "Bluetooth: **Bluetooth LE 5.0** - Classic Bluetooth is not supported"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:65
msgid "Flash: **2 MB**"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:66
msgid "SRAM: 272 KB"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:67
msgid "Firmware: **ESP-AT v4.1.1.0**, custom build that contains both the Wi-Fi AT and the BLE AT command sets"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:68
msgid "Serial port: **115200**, 8 data bits, no parity, 1 stop bit, no flow control"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:69
msgid "Module UART pins: TX0 = GPIO20, RX0 = GPIO19"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:70
msgid "Supply voltage: **3.3 V** (there is no 5 V pin)"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:71
msgid "Peak current: **more than 400 mA** during Wi-Fi / Bluetooth start-up"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:72
msgid "Logic level: **3.3 V** - the pins are **not 5 V tolerant** (absolute maximum 3.6 V)"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:73
msgid "Antenna: PCB antenna"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:74
msgid "Dimensions: **24 mm x 14 mm x 1.6 mm** (about 12 mm high with the header soldered)"
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:78
msgid "The module runs at **3.3 V** and its pins are **not 5 V tolerant** (absolute maximum 3.6 V). The adapter supplied with the kit performs the level conversion, so the module can be plugged straight into it - never wire the module to a 5 V signal without that adapter."
msgstr ""

#: ../../source/components_basic/41-component_espc201.rst:83
msgid "The kit also needs the **9V battery** (or a 6.5 - 12 V DC supply). Powered from USB alone the 3.3 V rail collapses when the module starts, and it never answers AT commands."
msgstr ""

