msgstr ""

#: ../../source/components_basic/12-component_dht11.rst:164
msgid "The |link_heat_index| is a way to measure how hot it feels outside by combining the air temperature and the humidity. It is also called the \"felt air temperature\" or \"apparent temperature\"."
msgstr ""

