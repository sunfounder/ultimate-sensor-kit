#: ../../source/fun_project/04-fun_Automatic_soap_dispenser.rst:18
msgid "Automatic soap dispenser"
msgstr ""

#: ../../source/fun_project/04-fun_Automatic_soap_dispenser.rst:27
msgid "The Automatic Soap Dispenser project uses an Arduino Uno board along with an infrared obstacle avoidance sensor and a water pump. The sensor detects the presence of an object such as a hand, which activates the water pump to dispense soap."
msgstr ""

